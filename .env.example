# Blessing Event — variables d'environnement

# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_... ou eyJ...

# Google OAuth 2.0 — configuration côté Supabase + Google Cloud (pas de clé dans le frontend)
# 1) Google Cloud Console (projet blessing-event) → API et services → Identifiants
#    - Type : ID client OAuth 2.0 (Application Web)
#    - Origines JS autorisées : https://www.blessing-event.com , http://localhost:3000
#    - URI de redirection : https://VOTRE_PROJET.supabase.co/auth/v1/callback
# 2) Supabase → Authentication → Providers → Google : coller Client ID + Client Secret
# 3) Supabase → Authentication → URL Configuration :
#    - Site URL : https://www.blessing-event.com
#    - Redirect URLs : https://www.blessing-event.com/ , http://localhost:3000/
# 4) Désactiver Email/Password si vous voulez Google uniquement (Providers → Email → off)
# 5) Exécuter supabase/migrations/012_google_oauth_profiles.sql dans SQL Editor

# PostgreSQL direct (migrations CLI uniquement — NE PAS exposer au frontend)
# Si db.xxx.supabase.co échoue (ENOTFOUND), utilisez le Session pooler :
# Dashboard Supabase → Settings → Database → Connection string → Session pooler
# SUPABASE_DB_URL=postgresql://postgres.apxxzwmowjgpdhuecdou:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres

# Clé service role — routes API Vercel uniquement (Vercel → Environment Variables)
# Dashboard Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Alias acceptés par les routes serverless :
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# CinetPay
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_NOTIFY_URL=https://blessing-event.com/api/payments/webhook
# CINETPAY_RETURN_URL=https://blessing-event.com/#my-tickets

# Emails de confirmation billets (Resend — https://resend.com)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Blessing Event <info@blessing-event.com>
# NOTIFICATION_EMAIL=info@blessing-event.com
# SITE_URL=https://blessing-event.com
